        "distractors": [
          {
            "optionId": "a",
            "reasonZh": "when 在从句中作时间状语，不符合 spent 的宾语位置。"
          },
          {
            "optionId": "b",
            "reasonZh": "where 在从句中作地点状语。"
          },
          {
            "optionId": "c",
            "reasonZh": "why 通常修饰 reason，不能指代 year。"
          }
        ]
      },
      "kind": "choice",
