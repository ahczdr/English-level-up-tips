      "explanation": {
        "summaryZh": "meets 是句子的谓语，表示俱乐部每周五见面。",
        "ruleZh": "先找主语，再找主语发出的动作。",
        "evidence": [],
        "distractors": [
          {
            "optionId": "b",
            "reasonZh": "club 是主语，不是谓语。"
          },
          {
            "optionId": "c",
            "reasonZh": "Friday 是时间名词。"
          }
        ]
      },
      "kind": "choice",
      "options": [
        {
          "id": "a",
          "text": "meets"
        },
        {
          "id": "b",
          "text": "club"
        },
        {
          "id": "c",
          "text": "Friday"
        }
      ],
      "answerOptionId": "a"
