      "explanation": {
        "summaryZh": "be used to doing 表示习惯于做某事。",
        "ruleZh": "注意 used to do 与 be used to doing 的区别。",
        "evidence": [],
        "distractors": [
          {
            "optionId": "b",
            "reasonZh": "过去常常做某事后接动词原形。"
          },
          {
            "optionId": "c",
            "reasonZh": "被用来做某事通常使用 be used to do。"
          }
        ]
      },
      "kind": "choice",
      "options": [
