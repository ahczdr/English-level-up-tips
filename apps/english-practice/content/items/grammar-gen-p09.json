{"id":"grammar-gen-p09","familyId":"grammar-gen-p09","skillIds":["grammar.tense","grammar.clause"],"level":"G0","section":"grammar","reviewMode":"recall","promptZh":"阅读短文，在空白处填入 1 个适当的单词或括号内单词的正确形式。","resourceId":"grammar-gen-res-p09","estimatedSeconds":300,"sourceIds":["tool-generated-practice"],"explanation":{"summaryZh":"语法填空：先通读确定时态主线，再逐空判断词性与从句结构。","ruleZh":"括号给词考词形转换，无词处多考功能词。","evidence":[{"resourceId":"grammar-gen-res-p09","paragraphId":"p1","quote":"Last winter, a small library {} (open) in our neig"}],"distractors":[]},"kind":"gaps","inputMode":"text","sharedOptions":[],"uniqueOptions":false,"segments":[{"type":"text","text":"Last winter, a small library "},{"type":"gap","gapId":"g1"},{"type":"text","text":"(open) in our neighbourhood. It "},{"type":"gap","gapId":"g2"},{"type":"text","text":"set up by retired teachers who wanted to help children after school. The rooms were old, "},{"type":"gap","gapId":"g3"},{"type":"text","text":"the volunteers painted them bright and warm."},{"type":"text","text":"The library is small, but it has more than two thousand books. Children can read there "},{"type":"gap","gapId":"g4"},{"type":"text","text":"(quiet), and volunteers answer questions "},{"type":"gap","gapId":"g5"},{"type":"text","text":"they meet difficult words. Every book has a card "},{"type":"gap","gapId":"g6"},{"type":"text","text":"shows who read it last."},{"type":"text","text":"Now the library opens every evening. It has become a place "},{"type":"gap","gapId":"g7"},{"type":"text","text":"families spend time together instead of "},{"type":"gap","gapId":"g8"},{"type":"text","text":"alone at home. Many parents say that their children have "},{"type":"gap","gapId":"g9"},{"type":"text","text":"(become) more interested in reading, and they are thankful "},{"type":"gap","gapId":"g10"},{"type":"text","text":"the teachers' kindness."}],"gaps":[{"id":"g1","label":"第1空","clue":"括号给词 open：时态","options":[],"accepted":["opened"],"explanationZh":"一般过去时"},{"id":"g2","label":"第2空","clue":"无提示词：被动语态","options":[],"accepted":["was"],"explanationZh":"was set up"},{"id":"g3","label":"第3空","clue":"无提示词：连词","options":[],"accepted":["but","yet"],"explanationZh":"转折"},{"id":"g4","label":"第4空","clue":"括号给词 quiet：副词","options":[],"accepted":["quietly"],"explanationZh":"修饰 read"},{"id":"g5","label":"第5空","clue":"无提示词：时间连词","options":[],"accepted":["when","whenever"],"explanationZh":"时间状语从句"},{"id":"g6","label":"第6空","clue":"无提示词：定语从句","options":[],"accepted":["that","which"],"explanationZh":"先行词 card"},{"id":"g7","label":"第7空","clue":"无提示词：关系副词","options":[],"accepted":["where"],"explanationZh":"地点从句"},{"id":"g8","label":"第8空","clue":"填动名词","options":[],"accepted":["sitting"],"explanationZh":"instead of + 动名词"},{"id":"g9","label":"第9空","clue":"括号给词 become：过去分词","options":[],"accepted":["become"],"explanationZh":"have become"},{"id":"g10","label":"第10空","clue":"无提示词：介词","options":[],"accepted":["for"],"explanationZh":"thankful for"}],"policy":{"caseSensitive":false,"allowTerminalPunctuation":true}}
