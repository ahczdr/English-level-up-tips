      "id": "reading-club",
      "paragraphs": [
        {
          "id": "p1",
          "text": "The school reading club meets in Room 203 every Friday after school. Students bring one book and share a short story. New members can join without paying."
        }
      ],
      "audioAssetId": null,
      "transcript": null
    },
    {
      "id": "continuation-club",
      "paragraphs": [
        {
          "id": "p1",
          "text": "Lily wanted to join the school reading club, but she was afraid to speak in front of others. On Friday, she stood outside Room 203 with a book in her hands. Tom noticed her and opened the door."
        }
      ],
      "audioAssetId": null,
      "transcript": null
    }
